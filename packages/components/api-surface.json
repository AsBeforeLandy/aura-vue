{
  "exports": [
    "AuraComponents",
    "Button",
    "Divider",
    "Form",
    "FormItem",
    "Input",
    "Modal",
    "Select",
    "Space",
    "Switch",
    "Tag",
    "Typography",
    "buttonProps",
    "components",
    "default",
    "dividerProps",
    "formContextKey",
    "formItemHookKey",
    "formItemProps",
    "formProps",
    "inputProps",
    "modalProps",
    "selectProps",
    "spaceProps",
    "switchProps",
    "tagProps",
    "typographyProps",
    "useControllable",
    "validateValue"
  ],
  "componentMap": "components",
  "components": {
    "Button": {
      "props": {
        "block": {
          "type": ["Boolean"],
          "default": false
        },
        "disabled": {
          "type": ["Boolean"],
          "default": false
        },
        "loading": {
          "type": ["Boolean"],
          "default": false
        },
        "size": {
          "type": ["String"],
          "default": "middle"
        },
        "type": {
          "type": ["String"],
          "default": "default"
        }
      },
      "emits": ["click"]
    },
    "Input": {
      "props": {
        "clearable": {
          "type": ["Boolean"],
          "default": false
        },
        "defaultValue": {
          "type": ["String"]
        },
        "disabled": {
          "type": ["Boolean"],
          "default": false
        },
        "modelValue": {
          "type": ["String"]
        },
        "placeholder": {
          "type": ["String"],
          "default": ""
        }
      },
      "emits": ["change", "clear", "update:modelValue"]
    },
    "Form": {
      "props": {
        "model": {
          "type": ["Object"],
          "required": true
        }
      },
      "emits": []
    },
    "FormItem": {
      "props": {
        "label": {
          "type": ["String"],
          "default": ""
        },
        "prop": {
          "type": ["String"]
        },
        "required": {
          "type": ["Boolean"],
          "default": false
        },
        "rules": {
          "type": ["Array"],
          "default": "[function]"
        }
      },
      "emits": []
    },
    "Switch": {
      "props": {
        "defaultValue": {
          "type": ["Boolean"],
          "default": false
        },
        "disabled": {
          "type": ["Boolean"],
          "default": false
        },
        "modelValue": {
          "type": ["Boolean"]
        }
      },
      "emits": ["change", "update:modelValue"]
    },
    "Select": {
      "props": {
        "defaultValue": {
          "type": ["String"]
        },
        "disabled": {
          "type": ["Boolean"],
          "default": false
        },
        "modelValue": {
          "type": ["String"]
        },
        "options": {
          "type": ["Array"],
          "default": "[function]"
        },
        "placeholder": {
          "type": ["String"],
          "default": ""
        }
      },
      "emits": ["change", "update:modelValue"]
    },
    "Modal": {
      "props": {
        "closeOnClickMask": {
          "type": ["Boolean"],
          "default": true
        },
        "closeOnEsc": {
          "type": ["Boolean"],
          "default": true
        },
        "footer": {
          "type": ["Boolean"],
          "default": true
        },
        "modelValue": {
          "type": ["Boolean"],
          "default": false
        },
        "title": {
          "type": ["String"],
          "default": ""
        },
        "width": {
          "type": ["Number", "String"],
          "default": 520
        }
      },
      "emits": ["cancel", "close", "ok", "update:modelValue"]
    },
    "Divider": {
      "props": {
        "dashed": {
          "type": ["Boolean"],
          "default": false
        },
        "direction": {
          "type": ["String"],
          "default": "horizontal"
        },
        "orientation": {
          "type": ["String"],
          "default": "center"
        }
      },
      "emits": []
    },
    "Space": {
      "props": {
        "align": {
          "type": ["String"]
        },
        "direction": {
          "type": ["String"],
          "default": "horizontal"
        },
        "size": {
          "type": ["Number", "String"],
          "default": "middle"
        },
        "wrap": {
          "type": ["Boolean"],
          "default": false
        }
      },
      "emits": []
    },
    "Tag": {
      "props": {
        "closable": {
          "type": ["Boolean"],
          "default": false
        },
        "defaultVisible": {
          "type": ["Boolean"],
          "default": true
        },
        "type": {
          "type": ["String"],
          "default": "info"
        },
        "visible": {
          "type": ["Boolean"]
        }
      },
      "emits": ["close", "update:visible"]
    },
    "Typography": {
      "props": {
        "delete": {
          "type": ["Boolean"],
          "default": false
        },
        "level": {
          "type": ["Number"]
        },
        "strong": {
          "type": ["Boolean"],
          "default": false
        },
        "type": {
          "type": ["String"]
        },
        "underline": {
          "type": ["Boolean"],
          "default": false
        }
      },
      "emits": []
    }
  }
}
