{
  "name": "@aura-vue/business",
  "version": "0.1.0",
  "type": "module",
  "description": "Aura Vue3 业务组件库：基于 Element Plus 二次封装的 B 端场景组件",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "business",
    "pro-table",
    "pro-form",
    "admin",
    "element-plus"
  ],
  "license": "MIT",
  "author": "Aura Team",
  "homepage": "https://asbeforelandy.github.io/aura-vue/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsBeforeLandy/aura-vue.git",
    "directory": "packages/business"
  },
  "bugs": {
    "url": "https://github.com/AsBeforeLandy/aura-vue/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./src/*": "./src/*"
  },
  "sideEffects": [
    "**/*.less",
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/postbuild-dts.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "element-plus": "^2.8.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "lodash-unified": "^1.0.3",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@aura-vue/shared": "workspace:*",
    "@types/node": "^20.17.10",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.8.8",
    "happy-dom": "^15.7.4",
    "less": "^4.2.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.12"
  }
}
