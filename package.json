{
  "name": "aura-vue",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter @aura/components build",
    "test": "pnpm --filter @aura/components test",
    "docs:dev": "pnpm --filter @aura/docs dev",
    "docs:build": "pnpm --filter @aura/docs build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "typescript": "^5.6.3"
  }
}
